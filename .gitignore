.venv/
__pycache__/
store_raw_data_ss-01-hh-dd-MM/
store_db/
# The artifacts themselves are regenerable from the database, so they stay out.
# What is committed is what makes a folder readable without a run: the store's
# manifest guide, and each asset's parameters and README.
store_Assets_artifacts/**
!store_Assets_artifacts/EXAMPLE_TICKER_README.md
!store_Assets_artifacts/*/
!store_Assets_artifacts/*/*_parameters.json
!store_Assets_artifacts/*/*_README.md
